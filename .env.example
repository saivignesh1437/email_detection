# ==============================================================================
# Environment Configuration Template
# Intelligent Email Detection and Management Platform
# ==============================================================================

# 1. Environment & Mode
ENVIRONMENT=development # 'development' or 'production'

# 2. Database Configuration
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]
DATABASE_URL=postgresql://postgres@localhost:5432/email_management_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=email_management_db

# 3. Security & JWT Settings
# In production, use a high-entropy 256-bit secret key (e.g., openssl rand -hex 32)
SECRET_KEY=student_super_secret_jwt_key_email_management_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 4. Java DSA Spam Detection Engine
DSA_ENGINE_URL=http://127.0.0.1:8080
# Or separately:
# DSA_ENGINE_HOST=dsa-spam-engine
# DSA_ENGINE_PORT=8080

# 5. ML Model Configuration
MODEL_DIR=ml/model

# 6. Server & Network Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# 7. CORS Allowed Origins (comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# 8. Frontend Vite Environment Variable (used during npm run build)
# VITE_API_URL=http://localhost:8000/api
